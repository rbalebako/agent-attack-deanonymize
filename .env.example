# ── LLM backend ──────────────────────────────────────────────────────────────
# Choose "google" (default) or "ollama"
LLM_BACKEND=google

# Google / Gemini — required when LLM_BACKEND=google
# Get a key at https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Set TRUE to route Gemini calls through Vertex AI instead of the direct API
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Ollama — required when LLM_BACKEND=ollama
# Install Ollama and pull a model: https://ollama.com
#   ollama pull llama3.2        # recommended default
#   ollama pull mistral
#   ollama pull qwen2.5
# Note: tool-calling reliability varies by model. llama3.2 and mistral work well.
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434

# ── Search backend ────────────────────────────────────────────────────────────
# Tavily (default) — get a free key at https://tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Google Custom Search (alternative to Tavily)
# SEARCH_BACKEND=google
# GOOGLE_CSE_ID=your_custom_search_engine_id

# ── Run settings ──────────────────────────────────────────────────────────────
MAX_ITERATIONS=10
MAX_SEARCH_RESULTS=5
