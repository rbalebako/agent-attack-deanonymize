# Required: Gemini API key (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=your_gemini_api_key_here

# Required: Tavily search API key (https://tavily.com) — default search backend
TAVILY_API_KEY=your_tavily_api_key_here

# Optional: Google Custom Search (alternative to Tavily)
# GOOGLE_CSE_ID=your_custom_search_engine_id
# SEARCH_BACKEND=google  # set to "google" to use CSE instead of Tavily

# Model and run settings
GEMINI_MODEL=gemini-2.0-flash
MAX_ITERATIONS=10
MAX_SEARCH_RESULTS=5

# Set TRUE to use Vertex AI instead of the direct Gemini API
GOOGLE_GENAI_USE_VERTEXAI=FALSE
